/**
 * Oxide Color Theme -> Transparent Amber Theme
 **/
window {
    background-color: #000000b5;
    border: 0;
    padding: 5;
    border: 1px;
    border-radius: 15px;
    border-color: #FFBF00;
}
element {
    border:  0;
    padding: 4.5px;
}
element normal.normal {
    background-color: #ffbf0055;
    text-color:       #ffffffb5;
    border-radius: 15px;
}
element selected.normal {
    background-color: #ffbf00c5;
    text-color:       #ffffff;
    border-radius: 15px;
}
element alternate.normal {
    background-color: #ffbf0055;
    text-color:       #ffffffb5;
    border-radius: 15px;
}
scrollbar {
    width:        5px;
    border: 1px;
    border-radius: 15px;
    border-color: #FFBF00;
    handle-color: #ffbf0055;
    handle-width: 5px;
    padding:      0;
}
entry {
    spacing:    0;
    text-color: #ffffff;
}
prompt {
    spacing:    0;
    text-color: #ffffff;
}
